    {
      "id": "8a0202a9-5cd2-4bd1-b1bf-02d79e6ed2dc",
      "name": "Parse + code checks (sanitizer)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "jsCode": "// Parse sanitizer JSON and run hard code checks that do not depend on any model.\nconst raw = $('Normalize input').first().json;\nlet text = $input.first().json.text ?? $input.first().json.output ?? '';\ntext = String(text).replace(/^```(?:json)?/m, '').replace(/```\\s*$/m, '').trim();\n\nlet clean;\ntry { clean = JSON.parse(text); }\ncatch (e) { return [{ json: { ok: false, stage: 'sanitizer', reason: 'Sanitizer did not return valid JSON', text } }]; }\n\n// CONFIG: complete this list with every group name and common nickname you monitor.\nconst GROUP_NAMES = [\n  'TWAT', 'Watch Trader Community', 'Tuscanyrose', 'Tuscany Rose', 'Moda Watch Club', 'Moda'\n];\n\nconst flat = JSON.stringify(clean);\nconst problems = [];\n\nfor (const g of GROUP_NAMES) {\n  const re = new RegExp('\\\\b' + g.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\b', 'i');\n  if (re.test(flat)) problems.push('group name present: ' + g);\n}\nif (/https?:\\/\\/|www\\./i.test(flat)) problems.push('URL present');\nif (/(^|[\\s(])@[A-Za-z0-9_.]{3,}/.test(flat)) problems.push('handle present');\n// Dollar amounts: none allowed outside price_tiers. Inside price_tiers only round tier boundaries are allowed.\nconst tiers = clean.price_range || {};\nconst noTiers = JSON.stringify(Object.assign({}, clean, { price_range: null }));\nif (/\\$\\s?\\d/.test(noTiers)) problems.push('dollar amount outside price range');\nconst amountRe = /\\$\\s?(\\d[\\d,]*(?:\\.\\d+)?)\\s*(k|K)?/g;\nconst tierText = JSON.stringify(tiers);\nlet m;\nwhile ((m = amountRe.exec(tierText)) !== null) {\n  let v = parseFloat(m[1].replace(/,/g, ''));\n  if (m[2]) v = v * 1000;\n  const round = v >= 10000 ? v % 10000 === 0 : (v >= 1000 ? v % 1000 === 0 : v % 100 === 0);\n  if (!round) problems.push('non-round price amount: ' + m[0]);\n}\nif (/\\b(miami|hong kong)\\b/i.test(flat)) problems.push('specific location present');\nif (/\\b\\d{5,6}[A-Z]{0,2}\\b/.test(flat)) problems.push('reference-number-like token present');\nif (/\\b\\d+\\s+(posts|groups)\\b/i.test(flat)) problems.push('post or group count present');\n\n// Clamp the theft detail level: 1 = pattern only, 2 = generic case, 3 = only if publicly sourced.\nconst ts = clean.trust_and_safety || {};\nlet level = Number(ts.detail_level_allowed) || 1;\nif (level === 3 && ts.publicly_sourced !== true) level = 2;\nif (level > 3) level = 3;\nts.detail_level_allowed = level;\nclean.trust_and_safety = ts;\n\nif (problems.length) {\n  return [{ json: { ok: false, stage: 'sanitizer', reason: problems.join('; '), sanitized: clean, run_date: raw.run_date } }];\n}\nreturn [{ json: { ok: true, sanitized: clean, run_date: raw.run_date } }];"
      }
