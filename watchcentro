      "parameters": {
        "jsCode": "const prev = $('Parse writer output').first().json;\nlet text = $input.first().json.text ?? $input.first().json.output ?? '';\ntext = String(text).replace(/^```(?:json)?/m, '').replace(/```\\s*$/m, '').trim();\nlet review;\ntry { review = JSON.parse(text); }\ncatch (e) { review = { pass: false, problems: ['Reviewer did not return valid JSON: ' + text.slice(0, 200)] }; }\n\n// Same code checks as the sanitizer stage, run on the final post text.\nconst GROUP_NAMES = [\n  'TWAT', 'Watch Trader Community', 'Tuscanyrose', 'Tuscany Rose', 'Moda Watch Club', 'Moda'\n];\nconst flat = JSON.stringify(prev.post);\nconst problems = [...(review.problems || [])];\nfor (const g of GROUP_NAMES) {\n  const re = new RegExp('\\\\b' + g.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\b', 'i');\n  if (re.test(flat)) problems.push('code check: group name present: ' + g);\n}\nif (/https?:\\/\\/|www\\./i.test(flat)) problems.push('code check: URL present');\nif (/(^|[\\s(])@[A-Za-z0-9_.]{3,}/.test(flat)) problems.push('code check: handle present');\nif (/\\u2014/.test(flat)) problems.push('code check: em dash present');\nif (prev.ok === false) problems.push('writer output invalid: ' + (prev.reason || ''));\nconst factsText = JSON.stringify(prev.sanitized || {}).toLowerCase();\nconst dollars = flat.match(/\\$\\s?\\d[\\d,]*(?:\\.\\d+)?\\s*(?:k|K|m|M)?/g) || [];\nfor (const d of dollars) {\n  const norm = d.toLowerCase().replace(/\\s/g, '');\n  if (!factsText.replace(/\\s/g, '').includes(norm)) problems.push('code check: dollar figure not in sanitized facts: ' + d);\n}\nif (/[\\u{1F300}-\\u{1FAFF}]/u.test(flat)) problems.push('code check: emoji present');\nconst meta = $('Normalize input').first().json;\nif (prev.word_count < meta.word_min - 150 || prev.word_count > meta.word_max + 200) problems.push('code check: word count out of range: ' + prev.word_count);\n\nconst ok = review.pass === true && problems.length === 0;\nreturn [{ json: { ok, stage: 'reviewer', reason: problems.join('; '), post: prev.post, word_count: prev.word_count, run_date: prev.run_date } }];"
