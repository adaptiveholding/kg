        "jsCode": "const prev = $('Parse + code checks (sanitizer)').first().json;\nlet text = $input.first().json.text ?? $input.first().json.output ?? '';\ntext = String(text).replace(/^```(?:json)?/m, '').replace(/```\\s*$/m, '').trim();\nconst a = text.indexOf('{'), b = text.lastIndexOf('}');\nif (a >= 0 && b > a) text = text.slice(a, b + 1);\nlet post;\ntry { post = JSON.parse(text); }\ncatch (e) { return [{ json: { ok: false, stage: 'writer', reason: 'Writer did not return valid JSON (possibly truncated)', post: {}, word_count: 0, sanitized: prev.sanitized, run_date: prev.run_date } }]; }\n\nconst words = [post.summary, post.takeaway, post.closing, ...(post.sections || []).flatMap(s => s.paragraphs || [])].join(' ').split(/\\s+/).filter(Boolean).length;\n\nreturn [{ json: { ok: true, post, word_count: words, sanitized: prev.sanitized, run_date: prev.run_date } }];"
