      "parameters": {
        "jsCode": "// Normalize the webhook payload. Accepts the agreed JSON shape, plain JSON {digest}, or a plain text body.\nconst raw = $input.first().json;\nconst b = raw.body ?? raw;\nlet digest = '';\nif (typeof b === 'string') digest = b;\nelse if (b && typeof b.digest === 'string') digest = b.digest;\nelse if (b && typeof b.text === 'string') digest = b.text;\nelse digest = JSON.stringify(b);\ndigest = digest.trim();\nconst f = (typeof b === 'object' && b) ? b : {};\n\n// Window: explicit field first, otherwise detect from the digest's \"Window:\" line, otherwise 24h.\nlet windowKey = String(f.window || '').toLowerCase().trim();\nif (!['24h', '7d', '30d', '90d', 'custom'].includes(windowKey)) {\n  const line = (digest.match(/^\\s*window:.*$/im) || [''])[0].toLowerCase();\n  if (/90\\s*d|90-day|90 day|quarter/.test(line)) windowKey = '90d';\n  else if (/30\\s*d|30-day|30 day|month/.test(line)) windowKey = '30d';\n  else if (/7\\s*d|7-day|7 day|week/.test(line)) windowKey = '7d';\n  else windowKey = '24h';\n}\nconst LABELS = { '24h': 'Daily', '7d': 'Weekly', '30d': 'Monthly', '90d': 'Quarterly', 'custom': 'Special' };\nconst WORDS = { '24h': [450, 800], '7d': [700, 1100], '30d': [900, 1400], '90d': [900, 1400], 'custom': [600, 1200] };\n\nconst runType = f.run_type === 'cron' ? 'cron' : (f.run_type === 'adhoc' ? 'adhoc' : 'unspecified');\nlet mode = f.mode === 'live' || f.mode === 'test' ? f.mode : (runType === 'adhoc' ? 'test' : 'live');\n\nconst today = new Date().toISOString().slice(0, 10);\nconst runId = String(f.run_id || (today + '-' + windowKey));\n\n// Duplicate protection for live runs. Run ids are recorded only after a draft is created.\nconst store = $getWorkflowStaticData('global');\nconst seen = store.liveRunIds || {};\nconst duplicate = mode === 'live' && Object.prototype.hasOwnProperty.call(seen, runId);\n\nreturn [{ json: {\n  raw_digest: digest,\n  run_date: today,\n  window: windowKey,\n  window_label: LABELS[windowKey],\n  word_min: WORDS[windowKey][0],\n  word_max: WORDS[windowKey][1],\n  period_start: f.period_start || null,\n  period_end: f.period_end || null,\n  run_type: runType,\n  mode,\n  run_id: runId,\n  digest_format_version: String(f.digest_format_version || '1'),\n  duplicate,\n  ok: !duplicate,\n  stage: duplicate ? 'duplicate' : null,\n  reason: duplicate ? ('A live draft was already created for run_id ' + runId) : null\n} }];"
